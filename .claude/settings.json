{
  "permissions": {
    "allow": [
      "Bash(uv:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(black:*)",
      "Bash(python:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(curl http://air4thai*)",
      "Bash(curl https://api.openaq.org*)",
      "Bash(curl https://firms.modaps.eosdis.nasa.gov*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(curl http*)",
      "WebFetch"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push:*)",
      "Bash(uv add:*)",
      "Bash(uv pip install:*)"
    ]
  },
  "env": {
    "PYTHONDONTWRITEBYTECODE": "1",
    "PYTHONUNBUFFERED": "1"
  }
}
